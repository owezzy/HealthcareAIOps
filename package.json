{
  "name": "healthcare-aiops-tooling",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "lint": "eslint \"apps/web/**/*.{js,cjs,mjs,ts,mts}\" \"apps/web/**/*.html\" \"services/copilot-runtime/**/*.{js,cjs,mjs,ts,mts}\"",
    "format": "prettier --write \"apps/web/src/app/**/*.{js,cjs,mjs,ts,html,css,scss,json}\" \"apps/web/src/{main.ts,index.html}\" \"apps/web/src/styles/**/*.{css,scss}\" \"apps/web/{tailwind.config.js,vite.config.mts,package.json}\" \"services/copilot-runtime/src/**/*.{js,cjs,mjs,ts,json}\" \"services/copilot-runtime/package.json\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^22.7.0",
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "3.3.0",
    "prettier-plugin-organize-imports": "3.2.4",
    "prettier-plugin-tailwindcss": "0.6.1",
    "typescript-eslint": "^8.49.0"
  },
  "lint-staged": {
    "apps/web/**/*.{js,cjs,mjs,ts,mts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "apps/web/**/*.html": [
      "eslint --fix",
      "prettier --write"
    ],
    "services/copilot-runtime/**/*.{js,cjs,mjs,ts,mts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "{packages,services}/**/*.py": [
      "uv run --no-sync ruff check --fix",
      "uv run --no-sync ruff format"
    ],
    "{apps/web,services/copilot-runtime}/**/*.{css,scss,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
